<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:h="clr-namespace:AlerteProche.Helpers"
             xmlns:c="clr-namespace:AlerteProche.Controls"
             xmlns:vm="clr-namespace:AlerteProche.ViewModels"
             x:Class="AlerteProche.Pages.AlerteActivePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource PageBackground}">
  <Grid RowDefinitions="Auto,*">
    <Grid BackgroundColor="{StaticResource Red}" Padding="20,40,20,14" ColumnDefinitions="Auto,*,Auto">
      <Label Text="⚠" FontSize="34" TextColor="White" VerticalOptions="Center" />
      <Label Grid.Column="1" Text="{h:Tr active_banner}" TextColor="White" FontAttributes="Bold" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
      <Button Grid.Column="2" Text="⏸" FontSize="24" TextColor="White" BackgroundColor="Transparent" BorderColor="White" BorderWidth="2" CornerRadius="24" WidthRequest="48" HeightRequest="48" Padding="0"
              Command="{Binding ToggleMuteCommand}" SemanticProperties.Description="{h:Tr active_mute}" />
    </Grid>
    <ScrollView Grid.Row="1">
      <VerticalStackLayout Padding="20,16" Spacing="12">
        <Label Text="{h:Tr active_title}" Style="{StaticResource Title}" />
        <Label Text="{h:Tr active_sub}" Style="{StaticResource Muted}" />
        <Border Style="{StaticResource Card}" Padding="0">
          <VerticalStackLayout BindableLayout.ItemsSource="{Binding Deliveries}">
            <BindableLayout.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,12">
                  <Label Text="👤" FontSize="34" VerticalOptions="Center" />
                  <Label Grid.Column="1" Text="{Binding Name}" FontAttributes="Bold" VerticalOptions="Center" />
                  <Border Grid.Column="2" BackgroundColor="{Binding Background}" StrokeThickness="0" Padding="10,6" VerticalOptions="Center">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                    <Label Text="{Binding Label}" TextColor="{Binding Foreground}" FontAttributes="Bold" FontSize="13" />
                  </Border>
                </Grid>
              </DataTemplate>
            </BindableLayout.ItemTemplate>
          </VerticalStackLayout>
        </Border>
        <Button Text="{h:Tr active_safe}" Style="{StaticResource PrimaryButton}" Command="{Binding SafeCommand}" />
        <Button Text="{Binding CallLabel}" Style="{StaticResource OutlineButton}" TextColor="{StaticResource Red}" BorderColor="{StaticResource Red}" Command="{Binding CallEmergencyCommand}" />
        <Button Text="{h:Tr active_numbers}" Style="{StaticResource LinkButton}" TextColor="{StaticResource Green}" FontSize="22" Command="{Binding NumbersCommand}" />
        <Label Text="{h:Tr active_escalation}" Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
      </VerticalStackLayout>
    </ScrollView>
  </Grid>
</ContentPage>
