<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

	<Style TargetType="Label">
		<Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
		<Setter Property="FontSize" Value="{DynamicResource FontBody}" />
	</Style>

	<Style x:Key="Title" TargetType="Label">
		<Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
		<Setter Property="FontSize" Value="{DynamicResource FontTitle}" />
		<Setter Property="FontAttributes" Value="Bold" />
	</Style>

	<Style x:Key="Muted" TargetType="Label">
		<Setter Property="TextColor" Value="{DynamicResource TextMuted}" />
		<Setter Property="FontSize" Value="{DynamicResource FontSmall}" />
	</Style>

	<Style x:Key="PrimaryButton" TargetType="Button">
		<Setter Property="BackgroundColor" Value="{StaticResource Green}" />
		<Setter Property="TextColor" Value="White" />
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="FontSize" Value="{DynamicResource FontButton}" />
		<Setter Property="CornerRadius" Value="18" />
		<Setter Property="MinimumHeightRequest" Value="56" />
	</Style>

	<Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
		<Setter Property="BackgroundColor" Value="{StaticResource Red}" />
	</Style>

	<Style x:Key="OutlineButton" TargetType="Button">
		<Setter Property="BackgroundColor" Value="Transparent" />
		<Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
		<Setter Property="BorderColor" Value="{DynamicResource CardBorder}" />
		<Setter Property="BorderWidth" Value="1" />
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="FontSize" Value="{DynamicResource FontButton}" />
		<Setter Property="CornerRadius" Value="18" />
		<Setter Property="MinimumHeightRequest" Value="56" />
	</Style>

	<Style x:Key="LinkButton" TargetType="Button">
		<Setter Property="BackgroundColor" Value="Transparent" />
		<Setter Property="TextColor" Value="{StaticResource Blue}" />
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="FontSize" Value="{DynamicResource FontBody}" />
	</Style>

	<Style x:Key="Card" TargetType="Border">
		<Setter Property="Stroke" Value="{DynamicResource CardBorder}" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="BackgroundColor" Value="{DynamicResource CardBackground}" />
		<Setter Property="Padding" Value="14" />
		<Setter Property="StrokeShape">
			<Setter.Value>
				<RoundRectangle CornerRadius="16" />
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="KeyButton" TargetType="Button">
		<Setter Property="BackgroundColor" Value="{DynamicResource CardBackground}" />
		<Setter Property="TextColor" Value="{StaticResource Navy}" />
		<Setter Property="BorderColor" Value="{DynamicResource CardBorder}" />
		<Setter Property="BorderWidth" Value="1" />
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="FontSize" Value="24" />
		<Setter Property="CornerRadius" Value="14" />
		<Setter Property="HeightRequest" Value="60" />
	</Style>

	<Style x:Key="BackButton" TargetType="Button">
		<Setter Property="BackgroundColor" Value="Transparent" />
		<Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
		<Setter Property="FontSize" Value="34" />
		<Setter Property="HorizontalOptions" Value="Start" />
		<Setter Property="Padding" Value="8,0" />
	</Style>

	<Style TargetType="Switch">
		<Setter Property="OnColor" Value="{StaticResource Green}" />
	</Style>
</ResourceDictionary>
