<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:h="clr-namespace:AlerteProche.Helpers"
             xmlns:c="clr-namespace:AlerteProche.Controls"
             xmlns:vm="clr-namespace:AlerteProche.ViewModels"
             x:Class="AlerteProche.Pages.PromessePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource PageBackground}">
  <Grid RowDefinitions="*,Auto" Padding="20,24">
    <ScrollView>
      <VerticalStackLayout Spacing="14">
        <Label Text="{h:Tr promise_title}" Style="{StaticResource Title}" FontSize="22" HorizontalTextAlignment="Center" />
        <Border Style="{StaticResource Card}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
          <Border WidthRequest="64" HeightRequest="64" BackgroundColor="{StaticResource Red}" StrokeThickness="0">
  <Border.StrokeShape><RoundRectangle CornerRadius="32" /></Border.StrokeShape>
  <Label Text="🔔" FontSize="32" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
</Border>
          <Label Grid.Column="1" Text="{h:Tr promise_1}" Style="{StaticResource Title}" FontSize="22" VerticalOptions="Center" />
        </Grid>
      </Border>
        <Border Style="{StaticResource Card}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
          <Border WidthRequest="64" HeightRequest="64" BackgroundColor="#3CB054" StrokeThickness="0">
  <Border.StrokeShape><RoundRectangle CornerRadius="32" /></Border.StrokeShape>
  <Label Text="✉" FontSize="32" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
</Border>
          <Label Grid.Column="1" Text="{h:Tr promise_2}" Style="{StaticResource Title}" FontSize="22" VerticalOptions="Center" />
        </Grid>
      </Border>
        <Border Style="{StaticResource Card}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
          <Border WidthRequest="64" HeightRequest="64" BackgroundColor="{StaticResource Blue}" StrokeThickness="0">
  <Border.StrokeShape><RoundRectangle CornerRadius="32" /></Border.StrokeShape>
  <Label Text="👥" FontSize="32" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
</Border>
          <Label Grid.Column="1" Text="{h:Tr promise_3}" Style="{StaticResource Title}" FontSize="22" VerticalOptions="Center" />
        </Grid>
      </Border>
        <Border Style="{StaticResource Card}" BackgroundColor="#FBF0DF" Stroke="#F0D9A8">
          <Label Text="{h:Tr promise_warning}" FontAttributes="Bold" TextColor="#111827" />
        </Border>
      </VerticalStackLayout>
    </ScrollView>
    <Button Grid.Row="1" Text="{h:Tr common_continue}" Command="{Binding ContinueCommand}" BackgroundColor="Black" TextColor="White" FontAttributes="Bold" FontSize="22" CornerRadius="22" HeightRequest="64" />
  </Grid>
</ContentPage>
