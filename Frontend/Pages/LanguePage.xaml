<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:h="clr-namespace:AlerteProche.Helpers"
             xmlns:c="clr-namespace:AlerteProche.Controls"
             xmlns:vm="clr-namespace:AlerteProche.ViewModels"
             x:Class="AlerteProche.Pages.LanguePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource PageBackground}">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="20,16">
    <Button Style="{StaticResource BackButton}" Text="‹" Command="{Binding BackCommand}" SemanticProperties.Description="{h:Tr a11y_back}" />
    <VerticalStackLayout Grid.Row="1" Spacing="18">
      <c:LogoView Accent="{StaticResource Navy}" />
      <BoxView HeightRequest="1" Color="{DynamicResource CardBorder}" />
      <Label Text="{h:Tr lang_title}" Style="{StaticResource Title}" HorizontalTextAlignment="Center" />
      <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
      <Border Grid.Column="0" Style="{StaticResource Card}" SemanticProperties.Description="Français">
        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding FrenchCommand}" /></Border.GestureRecognizers>
        <VerticalStackLayout Spacing="10" Padding="0,10">
          <Label Text="🇫🇷" FontSize="56" HorizontalOptions="Center" />
          <Label Text="Français" FontAttributes="Bold" FontSize="20" HorizontalOptions="Center" />
        </VerticalStackLayout>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource Card}" SemanticProperties.Description="English">
        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding EnglishCommand}" /></Border.GestureRecognizers>
        <VerticalStackLayout Spacing="10" Padding="0,10">
          <Label Text="🇬🇧" FontSize="56" HorizontalOptions="Center" />
          <Label Text="English" FontAttributes="Bold" FontSize="20" HorizontalOptions="Center" />
        </VerticalStackLayout>
      </Border>
      </Grid>
    </VerticalStackLayout>
    <Grid Grid.Row="3" ColumnDefinitions="*,*,*" ColumnSpacing="8" Padding="0,10">
    <VerticalStackLayout Grid.Column="0" Spacing="4" SemanticProperties.Description="{h:Tr lang_bigger}">
      <VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Command="{Binding BiggerCommand}" /></VerticalStackLayout.GestureRecognizers>
      <Label Text="👁" FontSize="34" HorizontalOptions="Center" />
      <Label Text="{h:Tr lang_bigger}" FontSize="13" HorizontalTextAlignment="Center" />
    </VerticalStackLayout>
    <VerticalStackLayout Grid.Column="1" Spacing="4" SemanticProperties.Description="{h:Tr lang_captions}">
      <VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Command="{Binding CaptionsCommand}" /></VerticalStackLayout.GestureRecognizers>
      <Label Text="👂" FontSize="34" HorizontalOptions="Center" />
      <Label Text="{h:Tr lang_captions}" FontSize="13" HorizontalTextAlignment="Center" />
    </VerticalStackLayout>
    <VerticalStackLayout Grid.Column="2" Spacing="4" SemanticProperties.Description="{h:Tr lang_contrast}">
      <VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Command="{Binding ContrastCommand}" /></VerticalStackLayout.GestureRecognizers>
      <Label Text="✋" FontSize="34" HorizontalOptions="Center" />
      <Label Text="{h:Tr lang_contrast}" FontSize="13" HorizontalTextAlignment="Center" />
    </VerticalStackLayout>
    </Grid>
  </Grid>
</ContentPage>
