<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:h="clr-namespace:AlerteProche.Helpers"
             xmlns:c="clr-namespace:AlerteProche.Controls"
             xmlns:vm="clr-namespace:AlerteProche.ViewModels"
             x:Class="AlerteProche.Pages.MesProchesPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource PageBackground}">
  <ScrollView>
    <VerticalStackLayout Padding="20,16" Spacing="14">
      <Label Text="{Binding Header}" Style="{StaticResource Title}" HorizontalTextAlignment="Center" Margin="0,10" />
      <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Items}">
        <BindableLayout.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Label Text="👤" FontSize="48" VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="1" Spacing="4">
                  <Label Text="{Binding FullName}" FontAttributes="Bold" FontSize="18" />
                  <Label Text="{Binding PhoneDisplay}" Style="{StaticResource Muted}" />
                  <Border BackgroundColor="{Binding RoleBg}" StrokeThickness="0" Padding="10,4" HorizontalOptions="Start">
                    <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                    <Border.GestureRecognizers>
                      <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MesProchesViewModel}}, Path=MakePrimaryCommand}" CommandParameter="{Binding .}" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding RoleLabel}" TextColor="{Binding RoleFg}" FontAttributes="Bold" FontSize="13" />
                  </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="End">
                  <Label Text="{Binding StatusLabel}" TextColor="{Binding StatusColor}" FontAttributes="Bold" FontSize="13" HorizontalTextAlignment="End" />
                  <HorizontalStackLayout HorizontalOptions="End" Spacing="2">
                    <Button Text="✎" FontSize="22" BackgroundColor="Transparent" TextColor="{DynamicResource TextPrimary}" Padding="8,0"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MesProchesViewModel}}, Path=EditCommand}" CommandParameter="{Binding .}" />
                    <Button Text="🗑" FontSize="22" BackgroundColor="Transparent" Padding="8,0"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MesProchesViewModel}}, Path=RemoveCommand}" CommandParameter="{Binding .}" />
                  </HorizontalStackLayout>
                </VerticalStackLayout>
              </Grid>
            </Border>
          </DataTemplate>
        </BindableLayout.ItemTemplate>
      </VerticalStackLayout>
      <Button Text="{h:Tr contacts_add}" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}" />
      <Label Text="{h:Tr contacts_info}" Style="{StaticResource Muted}" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
