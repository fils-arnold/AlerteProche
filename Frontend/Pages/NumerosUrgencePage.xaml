<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:h="clr-namespace:AlerteProche.Helpers"
             xmlns:c="clr-namespace:AlerteProche.Controls"
             xmlns:vm="clr-namespace:AlerteProche.ViewModels"
             x:Class="AlerteProche.Pages.NumerosUrgencePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource PageBackground}">
  <ScrollView>
    <VerticalStackLayout Padding="20,16" Spacing="12">
      <Grid ColumnDefinitions="Auto,*">
        <Button Style="{StaticResource BackButton}" Text="‹" Command="{Binding BackCommand}" SemanticProperties.Description="{h:Tr a11y_back}" />
        <c:LogoView Grid.Column="1" Accent="{StaticResource Green}" />
      </Grid>
      <Border Style="{StaticResource Card}" BackgroundColor="#FBF0DF" Stroke="#F0D9A8">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
          <Label Text="⚠" FontSize="46" TextColor="#EA6F0B" VerticalOptions="Center" />
          <VerticalStackLayout Grid.Column="1">
            <Label Text="{h:Tr num_warning}" FontAttributes="Bold" FontSize="20" TextColor="#111827" />
            <Label Text="{h:Tr num_warning_text}" TextColor="#6B7280" />
          </VerticalStackLayout>
        </Grid>
      </Border>
      <Label Text="{h:Tr num_title}" TextColor="{StaticResource Green}" FontAttributes="Bold" FontSize="22" />
      <Border Style="{StaticResource Card}" Padding="0">
        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Numbers}">
          <BindableLayout.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,10">
                <Label Text="{Binding Icon}" FontSize="30" VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="1">
                  <Label Text="{Binding Label}" FontAttributes="Bold" />
                  <Label Text="{Binding Number}" Style="{StaticResource Muted}" />
                </VerticalStackLayout>
                <Button Grid.Column="2" Text="{h:Tr num_modify}" BackgroundColor="#E3F4E8" TextColor="{StaticResource Green}" FontAttributes="Bold" CornerRadius="16"
                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NumerosUrgenceViewModel}}, Path=EditCommand}" CommandParameter="{Binding .}" />
              </Grid>
            </DataTemplate>
          </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
      </Border>
      <Label Text="{h:Tr guide_title}" TextColor="{StaticResource Green}" FontAttributes="Bold" FontSize="22" />
      <Border Style="{StaticResource Card}" Padding="0">
        <VerticalStackLayout>
          <Button Text="{h:Tr guide_add}" Command="{Binding GuideCommand}" CommandParameter="add" BackgroundColor="Transparent" TextColor="{DynamicResource TextPrimary}" HorizontalOptions="Fill" />
          <BoxView HeightRequest="1" Color="{DynamicResource CardBorder}" />
          <Button Text="{h:Tr guide_alert}" Command="{Binding GuideCommand}" CommandParameter="alert" BackgroundColor="Transparent" TextColor="{DynamicResource TextPrimary}" />
          <BoxView HeightRequest="1" Color="{DynamicResource CardBorder}" />
          <Button Text="{h:Tr guide_access}" Command="{Binding GuideCommand}" CommandParameter="access" BackgroundColor="Transparent" TextColor="{DynamicResource TextPrimary}" />
        </VerticalStackLayout>
      </Border>
      <Button Text="{Binding CallLabel}" Style="{StaticResource PrimaryButton}" Command="{Binding CallPoliceCommand}" />
      <Label Text="{h:Tr num_remote}" Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
