<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="AlerteProche.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:AlerteProche.Pages"
       Shell.FlyoutBehavior="Disabled"
       Shell.NavBarIsVisible="False"
       Shell.TabBarBackgroundColor="{DynamicResource PageBackground}"
       Shell.TabBarTitleColor="{StaticResource Red}"
       Shell.TabBarUnselectedColor="{StaticResource Gray600}">

	<!-- Racine : l'écran de lancement décide ensuite entre l'inscription et l'accueil -->
	<ShellContent Route="splash" ContentTemplate="{DataTemplate pages:SplashPage}" />

	<!-- Application au quotidien : barre de 4 onglets -->
	<TabBar Route="main">
		<ShellContent x:Name="TabHome" Route="accueil" Title="Accueil" ContentTemplate="{DataTemplate pages:AccueilPage}">
			<ShellContent.Icon>
				<FontImageSource Glyph="🏠" Size="22" />
			</ShellContent.Icon>
		</ShellContent>
		<ShellContent x:Name="TabContacts" Route="proches" Title="Proches" ContentTemplate="{DataTemplate pages:MesProchesPage}">
			<ShellContent.Icon>
				<FontImageSource Glyph="👥" Size="22" />
			</ShellContent.Icon>
		</ShellContent>
		<ShellContent x:Name="TabHistory" Route="historique" Title="Historique" ContentTemplate="{DataTemplate pages:HistoriquePage}">
			<ShellContent.Icon>
				<FontImageSource Glyph="🕘" Size="22" />
			</ShellContent.Icon>
		</ShellContent>
		<ShellContent x:Name="TabSettings" Route="reglages" Title="Réglages" ContentTemplate="{DataTemplate pages:ReglagesPage}">
			<ShellContent.Icon>
				<FontImageSource Glyph="⚙" Size="22" />
			</ShellContent.Icon>
		</ShellContent>
	</TabBar>
</Shell>
